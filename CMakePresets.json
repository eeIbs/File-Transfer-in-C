{
    "version": 8,

    "configurePresets": [
        {
            "name": "GCC 15.1.0 x86_64-w64-mingw32",
            "displayName": "GCC 15.1.0 x86_64-w64-mingw32",
            "description": "Using GCC 15.1.0 with MinGW-w64",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/out/build/${presetName}",

            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "E:/MinGW/mingw64/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "E:/MinGW/mingw64/bin/g++.exe",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "GCC 15.1.0 x86_64-w64-mingw32",
            "configurePreset": "GCC 15.1.0 x86_64-w64-mingw32"
        }
    ]
}